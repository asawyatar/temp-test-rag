# Copy to .env and fill in. .env is gitignored; this file lists names only.

# Local Postgres from docker-compose.yml (local-only credentials, host port 5433).
DATABASE_URL=postgresql://atar:atar_local_dev@localhost:5433/atar_ai

# The existing Atar backend; residents are verified via its /tenancy/api/me.
# BACKEND_BASE_URL=https://...

# LOCAL DEVELOPMENT ONLY: trust the X-Tenant-Id header instead of the backend,
# so /v1/answer works on localhost. Never together with BACKEND_BASE_URL.
# DEV_AUTH=true

# OPENAI_API_KEY is always needed: the embedding model (text-embedding-3-large)
# is OpenAI's, whichever answer model runs. Without it nothing can be ingested
# or searched.
# OPENAI_API_KEY=

# The answer model: openai (default) or anthropic. Without that provider's key,
# /v1/answer answers 503 and atar-ask reports "not configured".
# ANSWER_PROVIDER=openai
# ANTHROPIC_API_KEY=

# How atar-ingest opens links.txt pages drawn by JavaScript:
# chrome (installed Google Chrome, default) | chromium (Playwright's) | off
# RENDER_BROWSER=chrome

# Used only by the test suite, so tests never touch the dev database.
TEST_DATABASE_URL=postgresql://atar:atar_local_dev@localhost:5433/atar_ai_test
